# ==============================================================================
# SentinelEDR Configuration Environment Template
# COPY THIS FILE TO .env AND CUSTOMIZE FOR YOUR LOCAL ENVIRONMENT
# ==============================================================================

# Application Environment (development | production | test)
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-insecure-default-to-a-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Bootstrap Administrator (provisioned automatically on startup if no admin exists)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=SentinelAdmin!2026Secure
BOOTSTRAP_ADMIN_ROLE=admin

# Database Settings
# For local development / quick start:
DATABASE_URL=sqlite:///./sentinel.db
# For Docker Compose / PostgreSQL production:
# DATABASE_URL=postgresql://sentinel_user:sentinel_password@postgres:5432/sentinel_db

# CORS Configuration (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting & Abuse Control
LOGIN_RATE_LIMIT_PER_MINUTE=15
EVENT_INGESTION_BATCH_LIMIT=100

# Detection & Storage
RULES_DIR=./rules
ALERT_DEDUPLICATION_WINDOW_MINUTES=10
DEMO_MODE=true

# Agent Shared Secret / Enrollment Key (for enrolling new agents)
AGENT_ENROLLMENT_TOKEN=sentinel-agent-enrollment-secret-key-change-me
